# Cloudflare Pages redirects file — replaces the apex->www and /fr->/
# redirects that used to live in middleware.ts. Static export has no
# server to run middleware at request time, so this takes over instead.
# Rules are matched top to bottom, first match wins.

# Apex -> www (splat preserves the path, e.g. /blog/foo -> /blog/foo)
https://mouhcinezhirou.com/*  https://www.mouhcinezhirou.com/:splat  301!

# "/fr" used to be the French homepage; French now lives at "/". 301 this
# so the SEO equity already built up on "/fr" carries over.
/fr       /            301
/fr/*     /:splat      301
